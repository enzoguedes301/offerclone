# Copie para .env.local (ignorado pelo git) e preencha com sua chave.
# Em produção, cadastre esta variável na Vercel:
#   Settings -> Environment Variables -> PIXGATE_API_KEY
# A chave fica no painel do PixGate em Integrations -> API Key.
PIXGATE_API_KEY=

# TikTok Events API (rastreamento server-side).
# Encontre em: TikTok Events Manager -> seu pixel -> Events API -> Generate Access Token
TIKTOK_ACCESS_TOKEN=
